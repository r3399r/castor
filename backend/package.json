{
  "name": "castor-backend",
  "version": "1.1.0",
  "scripts": {
    "lint:es": "eslint src",
    "fix:es": "npm run lint:es -- --fix",
    "lint:format": "prettier --config ./prettierrc.json --list-different \"./**/*.ts\" --ignore-path .gitignore",
    "fix:format": "npm run lint:format -- --write",
    "lint": "run-p lint:*",
    "fix": "run-s fix:*",
    "clean": "del-cli dist -f",
    "build": "tspc && esbuild src/index.ts --bundle --minify --platform=node --target=node22 --external:@sparticuz/chromium --outfile=dist/index.js",
    "pre:deploy": "run-s clean build"
  },
  "author": "Yue Chang",
  "license": "ISC",
  "dependencies": {
    "@castor/shared": "*",
    "@google/genai": "^1.49.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sparticuz/chromium": "^148.0.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.12.2",
    "bignumber.js": "^9.3.1",
    "date-fns": "^4.1.0",
    "firebase-admin": "^13.6.0",
    "inversify": "^7.10.1",
    "mysql2": "^3.15.1",
    "puppeteer-core": "^25.0.4",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.27",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@types/node": "^24.5.2",
    "@types/uuid": "^8.3.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "del-cli": "^7.0.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.36.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "typescript": "^5.9.2",
    "typescript-transform-paths": "^3.5.5"
  }
}
