# Template for `.env.local`, which is gitignored. Copy this file to
# `.env.local` and fill in the two blanks at the bottom.
#
# Three things read `.env.local`, and none of them is a deploy:
#
#   local.ts                        -- `npm run dev`, the local API server
#   regression/setup.ts             -- the regression suite
#   tools/simulateEcpayWebhook.ts   -- the ECPay webhook simulator
#
# The Lambdas get their environment from CloudFormation instead
# (`{{resolve:ssm:...}}` and the celestial-studio db-endpoint import), so
# nothing here reaches any deployed environment.
#
# You do NOT need this file. `localEnv.ts`, which both `local.ts` and
# `regression/setup.ts` import, defaults PROJECT, DB_HOST and DB_PWD to
# the local docker-compose values -- so on a fresh clone `npm run db:up`
# is enough for both test suites and for `npm run dev`. Fill this in when
# you need ECPay, or to point either of them somewhere else.

ENVR=local
PROJECT=castor

# 127.0.0.1 from the host. From inside a container, that is the container
# itself and every DB-backed test fails on connect -- the compose MySQL is
# on its own network. Use host.docker.internal (Docker Desktop), or attach
# the container to backend_new_default and use `mysql`.
DB_HOST=127.0.0.1

# The MYSQL_PASSWORD in docker-compose.yml. Not a secret: that file is in
# git, and this database only ever holds local test data.
DB_PWD=castorlocal

DB_POOL_SIZE=2
PORT=3001

# ECPay's stage mode. Nothing here is a merchant credential of ours, but
# fill these in locally rather than committing them -- HashKey and HashIV
# never belong in version control, whoever they belong to.
#
# The values are the shared test credentials ECPay publishes with its
# stage documentation (developers.ecpay.com.tw, 測試資訊). The regression
# suite does not read them -- the payment tests set their own -- so these
# matter only for `npm run dev` and the webhook simulator.
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# 'stage' or 'production'. Anything that is not exactly 'production' is
# treated as stage by src/lib/ecpay.ts.
ECPAY_MODE=stage

# Where a browser is sent back to after paying. For a real ECPay callback
# this has to become a tunnel URL on a domain: their servers only reach
# port 80/443, and never an IP address. See guides/24 of the ecpay skill
# for ngrok / Cloudflare Tunnel.
PUBLIC_BASE_URL=http://localhost:3000
