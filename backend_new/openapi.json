    "/api/subscription/me": {
      "get": {
        "operationId": "getApiSubscriptionMe",
        "summary": "The caller's own subscription",
        "description": "Answers with 200 and active:false rather than 403 -- \"you are not subscribed\" is the successful answer to this question, and the page asking it has an upgrade prompt to render.",
        "tags": [
          "subscription"
        ],
        "responses": {
          "200": {
            "description": "Access, billing and renewal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "active": {
                      "type": "boolean",
                      "description": "Whether an agreement period is in status `active`. A billing fact, not an access one."
                    },
                    "plan": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "expiresAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "ISO 8601 end of the active period, or null when there is none"
                    },
                    "entitled": {
                      "type": "boolean",
                      "description": "Whether paid features are available right now. The field to gate subscriber-only UI on: a cancelled agreement inside the period it already paid for reports active:false and entitled:true."
                    },
                    "autoRenew": {
                      "type": "boolean",
                      "description": "Whether anything will charge the card again. Not derivable from entitlement -- a day pass grants access with no agreement behind it."
                    }
                  },
                  "required": [
                    "active",
                    "plan",
                    "expiresAt",
                    "entitled",
                    "autoRenew"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/subscription/history": {
      "get": {
        "operationId": "getApiSubscriptionHistory",
        "summary": "Every period the caller has had",
        "description": "Newest first. Renewals, lapses and cancellations are each their own row, so this is where a client derives \"cancelled but still usable\" from.",
        "tags": [
          "subscription"
        ],
        "responses": {
          "200": {
            "description": "The periods, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "plan": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "description": "active, cancelled, expired or past_due"
                      },
                      "currentPeriodStart": {
                        "type": "string",
                        "description": "ISO 8601"
                      },
                      "currentPeriodEnd": {
                        "type": "string",
                        "description": "ISO 8601"
                      }
                    },
                    "required": [
                      "id",
                      "plan",
                      "status",
                      "currentPeriodStart",
                      "currentPeriodEnd"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/subscription/cancel": {
      "post": {
        "operationId": "postApiSubscriptionCancel",
        "summary": "Turn auto-renew off",
        "description": "Entitlement is not revoked: the period already paid for runs to its end, so the response normally reports active:false with entitled:true. One-way -- resubscribing means a new agreement, whose first charge is immediate.",
        "tags": [
          "subscription"
        ],
        "responses": {
          "200": {
            "description": "The status after cancelling, with autoRenew false by definition",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "active": {
                      "type": "boolean",
                      "description": "Whether an agreement period is in status `active`. A billing fact, not an access one."
                    },
                    "plan": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "expiresAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "ISO 8601 end of the active period, or null when there is none"
                    },
                    "entitled": {
                      "type": "boolean",
                      "description": "Whether paid features are available right now. The field to gate subscriber-only UI on: a cancelled agreement inside the period it already paid for reports active:false and entitled:true."
                    },
                    "autoRenew": {
                      "type": "boolean",
                      "description": "Whether anything will charge the card again. Not derivable from entitlement -- a day pass grants access with no agreement behind it."
                    }
                  },
                  "required": [
                    "active",
                    "plan",
                    "expiresAt",
                    "entitled",
                    "autoRenew"
                  ]
                }
              }
            }
          }
        }
      }
    },
